@startuml GoTripViet_UseCase_Auth
' ================================================
' DETAILED USE CASE: AUTHENTICATION & ACCOUNT
' ================================================
left to right direction
skinparam shadowing true
skinparam highlighting false

' Material Design Colors
!define COLOR_ACTOR #E0F7FA
!define COLOR_UC #C8E6C9

skinparam actor {
    BorderColor #333333
    BackgroundColor COLOR_ACTOR
    FontSize 13
    FontStyle Bold
}

skinparam usecase {
    BorderColor #2E7D32
    BackgroundColor COLOR_UC
    FontSize 12
    ArrowColor #455A64
}

skinparam package {
    BorderColor #555555
    FontSize 14
    FontStyle Bold
    BackgroundColor #FAFAFA
}

title <size:20><b>Sub-system: Xác Thực & Quản Lý Tài Khoản</b></size>

' ================================================
' ACTORS
' ================================================
actor "Khách (Guest)" as Guest
actor "Người Dùng (Auth User)" as AuthUser
actor "Google/Facebook" as IdP <<External>>

Guest <|-- AuthUser

' ================================================
' USE CASES
' ================================================
package "Authentication Service" {
    usecase "Đăng Ký Tài Khoản" as UC_Register
    usecase "Đăng Nhập (Email/Pass)" as UC_Login
    usecase "Đăng Nhập" as UC_SSO
    usecase "Khôi Phục Mật Khẩu" as UC_ForgotPassword
    usecase "Xác Thực Email" as UC_VerifyEmail
    usecase "Đổi Mật Khẩu" as UC_ChangePass
    usecase "Cập Nhật Hồ Sơ" as UC_UpdateProfile
    usecase "Đăng Xuất" as UC_Logout
}

' ================================================
' RELATIONSHIPS
' ================================================
Guest --> UC_Register
Guest --> UC_Login
Guest --> UC_SSO
Guest --> UC_ForgotPassword

UC_SSO <--> IdP : "Tokens"

AuthUser --> UC_ChangePass
AuthUser --> UC_UpdateProfile
AuthUser --> UC_Logout
AuthUser --> UC_VerifyEmail

UC_Register ..> UC_VerifyEmail : <<include>>
UC_ForgotPassword ..> UC_VerifyEmail : <<include>>

note right of UC_SSO
  Đăng nhập nhanh
  qua mạng xã hội
end note

legend bottom right
  |= Ký hiệu |= Ý nghĩa |
  | ───|> | **Kế thừa (Generalization)**:\nActor con có quyền của Actor cha |
  | ..include..> | **Bao gồm (Include)**:\nHành động bắt buộc |
endlegend

@enduml
